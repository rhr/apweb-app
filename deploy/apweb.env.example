# Copy to /etc/apweb/apweb.env (mode 600, owned by root): it holds secrets.
#   sudo install -d -m 755 /etc/apweb
#   sudo install -m 600 deploy/apweb.env.example /etc/apweb/apweb.env && sudo nano /etc/apweb/apweb.env

# HTTP Basic Auth for every request (any username, this password)
APW_PASSWORD=change-me

# The Ask feature uses the server's key; keep it behind APW_PASSWORD
APW_ASK_MODE=server
ANTHROPIC_API_KEY=sk-ant-...
